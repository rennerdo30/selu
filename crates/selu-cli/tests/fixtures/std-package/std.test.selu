import { finite, wholeNumber, clampOr, inUnitRange, roundTo, hasBit, hexEncode, hexDecode, adler32, truncateBytes, plainText, now, durationParts, after, every, warnOnceTo, inCombatLockdown, playerInCombat, playerClassToken, playerLevel, addonFile } from "@selu/std";

describe("numbers", () => {
  test("finite and whole", () => {
    expect(finite(2.5)).toBe(2.5);
    expect(finite(null)).toBe(null);
    expect(finite(0 / 0)).toBe(null);
    expect(finite(1 / 0)).toBe(null);
    expect(wholeNumber(3)).toBe(3);
    expect(wholeNumber(3.5)).toBe(null);
    expect(wholeNumber(-1)).toBe(null);
  });
  test("clamp, range, rounding, bits", () => {
    expect(clampOr(5, 0, 3, 1)).toBe(3);
    expect(clampOr(-2, 0, 3, 1)).toBe(0);
    expect(clampOr(null, 0, 3, 1)).toBe(1);
    expect(clampOr(0 / 0, 0, 3, 1)).toBe(1);
    expect(inUnitRange(0)).toBe(true);
    expect(inUnitRange(1.01)).toBe(false);
    expect(inUnitRange(null)).toBe(false);
    expect(roundTo(1.23456, 4)).toBe(1.2346);
    expect(roundTo(2.5)).toBe(3);
    expect(hasBit(5, 4)).toBe(true);
    expect(hasBit(5, 2)).toBe(false);
  });
});

describe("text", () => {
  test("hex round trip", () => {
    expect(hexEncode("Az|")).toBe("417A7C");
    expect(hexDecode("417a7c")).toBe("Az|");
    expect(hexDecode(hexEncode("äö"))).toBe("äö");
  });
  test("adler32", () => {
    expect(adler32("Wikipedia")).toBe("11e60398");
    expect(adler32("")).toBe("00000001");
  });
  test("truncateBytes keeps whole characters", () => {
    expect(truncateBytes("abc", 5)).toBe("abc");
    expect(truncateBytes("abcdef", 3)).toBe("abc");
    expect(truncateBytes("aä", 2)).toBe("a");
    expect(truncateBytes("aäb", 3)).toBe("aä");
  });
  test("plainText", () => {
    expect(plainText("|cffff0000red|r\tx")).toBe(" cffff0000red r x");
  });
});

describe("time", () => {
  test("now follows the clock", () => {
    const start = now();
    sim.advanceTime(2);
    expect(now() - start).toBe(2);
  });
  test("durationParts", () => {
    const p = durationParts(90061.7);
    expect(p.days).toBe(1);
    expect(p.hours).toBe(1);
    expect(p.minutes).toBe(1);
    expect(p.seconds).toBe(1);
    expect(durationParts(-5).seconds).toBe(0);
  });
  test("after and every, cancelled", () => {
    let once = 0;
    let ticks = 0;
    after(1, () => { once += 1; });
    const stopped = after(1, () => { once += 10; });
    stopped.cancel();
    const ticker = every(1, () => { ticks += 1; });
    sim.advanceTime(3.5);
    ticker.cancel();
    ticker.cancel();
    sim.advanceTime(3);
    expect(once).toBe(1);
    expect(ticks).toBe(3);
  });
});

describe("log", () => {
  test("warnOnceTo keeps keys per logger", () => {
    const seen: string[] = [];
    const first = warnOnceTo((m) => { seen.push(m); });
    const second = warnOnceTo((m) => { seen.push(m); });
    first("k", "one");
    first("k", "again");
    second("k", "two");
    expect(seen.join(",")).toBe("one,two");
  });
});

describe("game", () => {
  test("combat and player reads", () => {
    expect(inCombatLockdown()).toBe(false);
    expect(playerInCombat()).toBe(false);
    sim.setCombat(true);
    expect(inCombatLockdown()).toBe(true);
    expect(playerInCombat()).toBe(true);
    sim.setCombat(false);
    sim.setUnit("player", { class: "MAGE", level: 42 });
    expect(playerClassToken()).toBe("MAGE");
    expect(playerLevel()).toBe(42);
  });
});

test("addonFile names a file in the folder the game loaded the addon from", () => {
  expect(addonFile("Media\\Logo")).toBe("Interface\\AddOns\\StdCheck\\Media\\Logo");
  expect(addonFile("Media/HUD/GlyphClose")).toBe("Interface\\AddOns\\StdCheck\\Media\\HUD\\GlyphClose");
});
