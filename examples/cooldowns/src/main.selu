// Print a sorted sample cooldown list at login; these are not live spell cooldowns.
// Shows tuple returns, closures, sorting and loop control.
// Try: selu build examples/cooldowns, install the addon and log in.
// Offline: scripts\studio.bat examples\cooldowns, then fire PLAYER_LOGIN.

// Fixed sample data makes the report reproducible without live bag or spell APIs.
const cooldowns = [
  { spell: "Hearthstone", seconds: 754 },
  { spell: "Feign Death", seconds: 0 },
  { spell: "Bestial Wrath", seconds: 42 },
  { spell: "Aspect of the Cheetah", seconds: 0 },
  { spell: "Misdirection", seconds: 61 },
];

/** Minutes and seconds of a duration. */
function splitDuration(seconds: number): [number, number] {
  // Written tuple returns become Lua multiple results, without a tuple table.
  return [Math.floor(seconds / 60), seconds % 60];
}

function readable(seconds: number): string {
  const [minutes, remainingSeconds] = splitDuration(seconds);
  return minutes > 0 ? `${minutes}m ${remainingSeconds}s` : `${remainingSeconds}s`;
}

// Each returned closure owns an independent counter captured as a Lua upvalue.
function makeCounter(): () => number {
  let nextNumber = 0;
  return () => {
    nextNumber++;
    return nextNumber;
  };
}

// Register after setup so callbacks see initialized helpers and frames.
on PLAYER_LOGIN() {
  // filter creates a new array; sorting it leaves the sample order unchanged.
  const waiting = cooldowns.filter(cooldown => cooldown.seconds > 0);
  waiting.sort((a, b) => a.seconds - b.seconds);

  const nextLineNumber = makeCounter();
  for (const cooldown of waiting) {
    print(`${nextLineNumber()}. ${cooldown.spell}: ${readable(cooldown.seconds)}`);
  }

  let ready = 0;
  for (const cooldown of cooldowns) {
    if (cooldown.seconds > 0) {
      continue;
    }
    ready += 1;
  }
  print(`${ready} of ${cooldowns.length} spells are ready`);
}
