// Cooldowns: at login, lists spells that are still cooling down with a
// readable time, and counts the ones that are ready.
//
// Shows: functions with tuple returns and destructuring, `? :`, `continue`,
// `+=`/`++`, closures that keep their own state, and sorting with a compare
// function.

const cooldowns = [
  { spell: "Hearthstone", seconds: 754 },
  { spell: "Feign Death", seconds: 0 },
  { spell: "Bestial Wrath", seconds: 42 },
  { spell: "Aspect of the Cheetah", seconds: 0 },
  { spell: "Misdirection", seconds: 61 },
];

/** Minutes and seconds of a duration. */
function split(seconds: number): [number, number] {
  return [Math.floor(seconds / 60), seconds % 60];
}

function readable(seconds: number): string {
  const [minutes, rest] = split(seconds);
  return minutes > 0 ? `${minutes}m ${rest}s` : `${rest}s`;
}

/** A counter that remembers its value between calls. */
function counter(): () => number {
  let n = 0;
  return () => {
    n++;
    return n;
  };
}

on PLAYER_LOGIN() {
  const waiting = cooldowns.filter(c => c.seconds > 0);
  waiting.sort((a, b) => a.seconds - b.seconds);

  const line = counter();
  for (const c of waiting) {
    print(`${line()}. ${c.spell}: ${readable(c.seconds)}`);
  }

  let ready = 0;
  for (const c of cooldowns) {
    if (c.seconds > 0) {
      continue;
    }
    ready += 1;
  }
  print(`${ready} of ${cooldowns.length} spells are ready`);
}
