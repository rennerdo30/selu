const panel = CreateFrame("Frame", null, UIParent);
panel.SetSize(160, 60);
panel.SetPoint("CENTER", UIParent, "CENTER", 0, 0);
const texture = panel.CreateTexture();
texture.SetSize(160, 60);
const label = panel.CreateFontString();
label.SetText("Selu frames");
hookScript(panel, "OnShow", () => { print("Panel shown"); });
panel.Hide();
on PLAYER_LOGIN() {
  panel.Show();
  const width = panel.GetWidth() ?? 0;
  const height = panel.GetHeight() ?? 0;
  const textureWidth = texture.GetWidth() ?? 0;
  const textureHeight = texture.GetHeight() ?? 0;
  print(width, height, textureWidth, textureHeight);
  print(label.GetText() ?? "");
}
