// Display a merchant reminder with a button that dismisses the panel.
// Shows a background texture and a template-created button.
// Try: selu build examples/templated-frames, install and log in; click Got it.
// Offline: scripts\studio.bat examples\templated-frames, then fire PLAYER_LOGIN.

// Use declared Texture methods; source-only mixin names have no checked signature.
const panel = CreateFrame("Frame", null, UIParent);
panel.SetSize(260, 100);
panel.SetPoint("CENTER", UIParent, "CENTER", 0, 0);
const backdrop = panel.CreateTexture(null, "BACKGROUND");
backdrop.SetTexture("Interface/Tooltips/UI-Tooltip-Background");
backdrop.SetAllPoints(panel);
backdrop.SetVertexColor(0.1, 0.2, 0.3, 1);
const label = panel.CreateFontString(null, "OVERLAY", "GameFontNormal");
label.SetPoint("TOP", panel, "TOP", 0, -16);
label.SetText("Review grey items at a merchant.");

// The client template supplies button artwork; this example never sells items.
const button = CreateFrame("Button", null, panel, "UIPanelButtonTemplate");
button.SetSize(120, 24);
button.SetPoint("BOTTOM", panel, "BOTTOM", 0, 12);
button.SetText("Got it");

hookScript(button, "OnClick", () => {
  panel.Hide();
});

panel.Hide();

on PLAYER_LOGIN() {
  panel.Show();
  // Optional getters need fallbacks before interpolation into player-facing text.
  print(`Merchant reminder: ${panel.GetWidth() ?? 0}px; button: ${button.GetText() ?? ""}`);
}
