// Color is both the token type and the theme lookup.
import { Color as TokenColor } from "./tokens";
export type Color = TokenColor;

import { fonts as kitFonts } from "./fonts";

// Which font file the kit could apply, for diagnostics.
export function GetFontPath(): string? {
  return kitFonts.path;
}

export function GetFontSource(): string {
  return kitFonts.source;
}
