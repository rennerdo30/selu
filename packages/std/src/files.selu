// Paths to files the addon ships in its own folder.

// The client path of a file in this addon's folder, for SetTexture,
// PlaySoundFile and fonts: addonFile("Media\Logo") is
// "Interface\AddOns\<folder>\Media\Logo". It follows the folder the game
// loaded the addon from, so a copy installed under another folder name still
// finds its own art. Forward slashes count as backslashes.
export function addonFile(path: string): string {
  const parts = path.split("/");
  return `Interface\\AddOns\\${addonName()}\\${parts.join("\\")}`;
}
